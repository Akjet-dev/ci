{
 "values": {
  "deployment": {
   "dev": {
    "envBundle": {
     "secret": "app"
    },
    "namespace": "dev-lk-backend",
    "release": "backend"
   },
   "stage": {
    "envBundle": {
     "secret": "app"
    },
    "namespace": "stage-lk-backend",
    "release": "backend"
   }
  },
  "image": "ghcr.io/akjet-dev/backend"
 },
 "workflows": {
  "k8s-build.yml": {
   "calls": [
    {
     "if": null,
     "job": "validate",
     "outputs_read": [],
     "permissions": {
      "contents": "read",
      "packages": "read"
     },
     "ref": "8f4d8a16a3a6f741fb94ef904f4ccca43980afa3",
     "secrets": {},
     "uses": "deploy-k8s.yml",
     "with": {
      "chart-version": "0.1.0",
      "environment": "${{ startsWith(github.ref_name, 'stage-k8s/') && 'stage' || 'dev' }}",
      "validate-only": true
     }
    },
    {
     "if": null,
     "job": "image",
     "outputs_read": [
      "digest"
     ],
     "permissions": {
      "contents": "read",
      "packages": "write"
     },
     "ref": "8f4d8a16a3a6f741fb94ef904f4ccca43980afa3",
     "secrets": {
      "build-secrets": "COMPOSER_AUTH={\"http-basic\":{\"nova.laravel.com\":{\"username\":\"${{ secrets.NOVA_USERNAME }}\",\"password\":\"${{ secrets.NOVA_LICENSE_KEY }}\"}}}\n"
     },
     "uses": "build-image.yml",
     "with": {
      "push": "${{ github.ref == 'refs/heads/dev-k8s/release' || github.ref == 'refs/heads/stage-k8s/release' }}"
     }
    },
    {
     "if": "github.ref == 'refs/heads/dev-k8s/release' && vars.K8S_DEV_DEPLOY_ENABLED == 'true'",
     "job": "deploy-dev",
     "outputs_read": [],
     "permissions": {
      "contents": "read",
      "packages": "read"
     },
     "ref": null,
     "secrets": {
      "DEV_BACKEND_ENV": "${{ secrets.DEV_BACKEND_ENV }}"
     },
     "uses": "./.github/workflows/k8s-deploy.yml",
     "with": {
      "digest": "${{ needs.image.outputs.digest }}",
      "run-migrations": "${{ vars.K8S_DEV_RUN_MIGRATIONS == 'true' }}"
     }
    }
   ],
   "interface": null
  },
  "k8s-deploy.yml": {
   "calls": [
    {
     "if": "github.ref == 'refs/heads/dev-k8s/release' && vars.K8S_DEV_DEPLOY_ENABLED == 'true'",
     "job": "deploy-dev",
     "outputs_read": [],
     "permissions": {
      "contents": "read",
      "packages": "read"
     },
     "ref": "8f4d8a16a3a6f741fb94ef904f4ccca43980afa3",
     "secrets": {
      "env-bundle": "${{ secrets.DEV_BACKEND_ENV }}"
     },
     "uses": "deploy-k8s.yml",
     "with": {
      "chart-version": "0.1.0",
      "environment": "dev",
      "image-digest": "${{ inputs.digest }}",
      "restart": "${{ inputs.restart }}",
      "run-migrations": "${{ inputs.run-migrations }}"
     }
    }
   ],
   "interface": {
    "inputs": {
     "digest": {
      "default": null,
      "required": true,
      "type": "string"
     },
     "restart": {
      "default": false,
      "required": false,
      "type": "boolean"
     },
     "run-migrations": {
      "default": false,
      "required": false,
      "type": "boolean"
     }
    },
    "secrets": {
     "DEV_BACKEND_ENV": false
    }
   }
  }
 }
}
