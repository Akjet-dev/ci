{
 "workflows": {
  "k8s-build.yml": {
   "calls": [
    {
     "if": null,
     "job": "validate",
     "outputs_read": [],
     "permissions": {
      "contents": "read",
      "packages": "read"
     },
     "ref": "a44236813f8ef4e3f1a96ace53f5642e06672e1c",
     "secrets": {},
     "uses": "deploy-k8s.yml",
     "with": {
      "chart-version": "0.1.0",
      "environment": "${{ startsWith(github.ref_name, 'stage-k8s/') && 'stage' || 'dev' }}",
      "validate-only": true
     }
    },
    {
     "if": null,
     "job": "image",
     "outputs_read": [
      "digest"
     ],
     "permissions": {
      "contents": "read",
      "packages": "write"
     },
