     "secrets": {},
     "uses": "build-image.yml",
     "with": {
      "dockerfile": "Dockerfile.k8s",
      "push": "${{ github.ref == 'refs/heads/dev-k8s/release' || github.ref == 'refs/heads/stage-k8s/release' }}"
     }
    },
    {
     "if": "github.ref == 'refs/heads/dev-k8s/release' && vars.K8S_DEV_DEPLOY_ENABLED == 'true'",
     "job": "deploy-dev",
     "outputs_read": [],
     "permissions": {
      "contents": "read",
      "packages": "read"
     },
     "ref": null,
     "secrets": {},
     "uses": "./.github/workflows/k8s-deploy.yml",
     "with": {
      "digest": "${{ needs.image.outputs.digest }}",
      "run-migrations": "${{ vars.K8S_DEV_RUN_MIGRATIONS == 'true' }}"
     }
    }
   ],
   "interface": null
  },
  "k8s-deploy.yml": {
   "calls": [
    {
     "if": "github.ref == 'refs/heads/dev-k8s/release' && vars.K8S_DEV_DEPLOY_ENABLED == 'true'",
     "job": "deploy-dev",
     "outputs_read": [],
     "permissions": {
      "contents": "read",
      "packages": "read"
     },
     "ref": "a44236813f8ef4e3f1a96ace53f5642e06672e1c",
     "secrets": {},
     "uses": "deploy-k8s.yml",
     "with": {
      "chart-version": "0.1.0",
      "environment": "dev",
      "image-digest": "${{ inputs.digest }}",
      "restart": "${{ inputs.restart }}",
      "run-migrations": "${{ inputs.run-migrations }}"
     }
    }
   ],
   "interface": {
    "inputs": {
     "digest": {
      "default": null,
      "required": true,
      "type": "string"
     },
     "restart": {
      "default": false,
      "required": false,
      "type": "boolean"
     },
     "run-migrations": {
      "default": false,
      "required": false,
      "type": "boolean"
     }
    },
    "secrets": {}
   }
  }
 }
